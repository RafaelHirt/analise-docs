{
  "name": "analise-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard independente para análise documental e conferência das exigências da SES.",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "npm run build && node scripts/dev-local.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint public netlify tests scripts/*.mjs",
    "validate": "npm test && npm run lint",
    "test:browser": "npm run build && node scripts/smoke-browser.mjs",
    "benchmark:busca": "node scripts/benchmark-busca.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "eslint": "10.14.0",
    "exceljs": "4.4.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "5.4.624",
    "playwright-core": "1.56.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
